# Copy to .env for local development; set the same keys in Hostinger hPanel for production.
# Local: file:./dev.db   Production (Hostinger MySQL): mysql://USER:PASSWORD@HOST:3306/DBNAME
DATABASE_URL="file:./dev.db"
# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""
SITE_URL="https://your-domain.com"
# mock = sample data; ssi = SSI FastConnect Data (needs the two SSI keys below)
MARKET_PROVIDER="mock"
SSI_CONSUMER_ID=""
SSI_CONSUMER_SECRET=""
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_PASSWORD=""
# Local only: creates a demo client account. Leave unset in production.
SEED_DEMO=""
